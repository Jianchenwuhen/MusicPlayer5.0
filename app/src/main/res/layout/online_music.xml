<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim" />

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="在线音乐"
            style="@style/Text.Display" />

        <!-- 搜索面板 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            style="@style/Panel.Glass">

            <EditText
                android:id="@+id/searchKeyword"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/input_field"
                android:hint="输入歌曲或歌手，例如 Jay"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingLeft="@dimen/space_md"
                android:paddingRight="@dimen/space_md"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/searchOnlineMusic"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="搜索"
                    style="@style/Widget.Button.Primary" />

                <Button
                    android:id="@+id/loadOnlineMusic"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="随机推荐"
                    style="@style/Widget.Button.Secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- 结果区：列表 / 状态提示 / 加载中 三态叠放 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_weight="1">

            <ListView
                android:id="@+id/onlineList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/panel_glass"
                android:cacheColorHint="#00000000"
                android:divider="@color/stroke_soft"
                android:dividerHeight="8dp"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xs"
                android:visibility="gone" />

            <TextView
                android:id="@+id/onlineStatus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/panel_glass"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:padding="@dimen/space_xl"
                android:text="输入关键词搜索，或点击随机推荐获取在线歌曲"
                style="@style/Text.Body" />

            <ProgressBar
                android:id="@+id/onlineProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/accent_primary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
