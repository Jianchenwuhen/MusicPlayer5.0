<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context="com.example.musicplayer50.MainActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim" />

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- 顶部：标题 + 导航 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Music Player"
                style="@style/Text.Headline" />

            <Button
                android:id="@+id/localmusic"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:minWidth="0dp"
                android:paddingLeft="@dimen/space_lg"
                android:paddingRight="@dimen/space_lg"
                android:text="本地"
                style="@style/Widget.Button.Secondary" />

            <Button
                android:id="@+id/onlinemusic"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginLeft="@dimen/space_sm"
                android:minWidth="0dp"
                android:paddingLeft="@dimen/space_lg"
                android:paddingRight="@dimen/space_lg"
                android:text="在线"
                style="@style/Widget.Button.Primary" />
        </LinearLayout>

        <!-- 波形可视化面板 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="@dimen/space_lg"
            style="@style/Panel.Glass">

            <com.example.musicplayer50.AudioWaveView
                android:id="@+id/audioWaveView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- 歌词 -->
        <ListView
            android:id="@+id/lyricListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_weight="1"
            android:background="@drawable/panel_glass"
            android:cacheColorHint="#00000000"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_lg"
            android:stackFromBottom="false"
            android:transcriptMode="disabled" />

        <!-- 正在播放面板 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="vertical"
            style="@style/Panel.Glass">

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Title"
                style="@style/Text.Title" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:ellipsize="end"
                android:hint="Artist"
                android:maxLines="1"
                style="@style/Text.Body" />

            <!-- 进度 + 时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/currentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:text="00:00"
                    style="@style/Text.Caption" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="@dimen/space_sm"
                    android:layout_marginRight="@dimen/space_sm"
                    android:indeterminate="false"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:progressDrawable="@drawable/seekbarbg"
                    android:thumb="@drawable/seek_thumb" />

                <TextView
                    android:id="@+id/totalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="44dp"
                    android:text="00:00"
                    style="@style/Text.Caption" />
            </LinearLayout>

            <!-- 控制按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/playlast"
                    android:layout_width="@dimen/control_secondary"
                    android:layout_height="@dimen/control_secondary"
                    android:background="@drawable/control_prev"
                    android:foreground="@drawable/ripple_circle"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/play"
                    android:layout_width="@dimen/control_primary"
                    android:layout_height="@dimen/control_primary"
                    android:layout_marginLeft="34dp"
                    android:layout_marginRight="34dp"
                    android:background="@drawable/control_play"
                    android:foreground="@drawable/ripple_circle"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/playnext"
                    android:layout_width="@dimen/control_secondary"
                    android:layout_height="@dimen/control_secondary"
                    android:background="@drawable/control_next"
                    android:foreground="@drawable/ripple_circle"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp" />
            </LinearLayout>

            <Button
                android:id="@+id/playlist"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_md"
                android:text="播放列表"
                style="@style/Widget.Button.Secondary" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
